/*
 * dengue_day1_wk2_deepthought.config
 *
 * Dengue scRNA-seq Day -1 + Week 2 — E-MTAB-9467 (Arora et al. 2022)
 * Four sample groups, 2 libraries each:
 *   DF_day1 (sample_id=DF, scapture_group_id=DF_day1)
 *   DHF_day1 (sample_id=DHF, scapture_group_id=DHF_day1)
 *   DF_wk2   (sample_id=DF_wk2, scapture_group_id=DF_wk2)
 *   DHF_wk2  (sample_id=DHF_wk2, scapture_group_id=DHF_wk2)
 * Chemistry: 10x Chromium 3' v2 (26 bp R1: 16 bp CB + 10 bp UMI).
 *
 * Usage:
 *   nextflow run main.nf \
 *     -profile deepthought,apptainer,dengue_day1_wk2_deepthought \
 *     -work-dir /path/to/your/workdir \
 *     -resume \
 *     --outdir /path/to/your/results/day1_wk2 \
 *     --apptainer_cache_dir /scratch/cache/apptainer
 *
 * NOTE — barcode whitelist:
 *   The 10x v2 whitelist (737K-august-2016.txt) is not staged.
 *   STARsolo will run with --soloCBwhitelist None and CellRanger2.2 knee-point
 *   filtering, which is acceptable for exploratory runs.
 *
 * Cache note:
 *   Using the same -work-dir as the day1 run + -resume reuses STARsolo and
 *   barcode-filtering results for sample_id=DF and sample_id=DHF (day1 libs).
 *   Only DF_wk2 and DHF_wk2 need fresh alignment. SCAPTURE re-runs for all 4
 *   groups but each group is now 2 libs — same scale as the day1 run that worked.
 */
params {

    // ── Input ──────────────────────────────────────────────────────────────
    input = "${projectDir}/tests/data/samplesheet_dengue_day1_wk2.csv"

    // ── Reference — GRCh38 (same build as pbmc1k) ─────────────────────────
    genome_fasta = '/scratch/data/reference/GRCh38/genome.fa'
    gtf          = '/scratch/data/reference/GRCh38/genes.gtf'

    // Regenerate against these references. The previous prebuilt_star_index
    // setting was ignored; the workflow consumes params.star_index.
    star_index = null

    // ── polyA atlas ────────────────────────────────────────────────────────
    known_polya = '/scratch/data/polya_atlas/polyasite2_GRCh38.tsv'

    // ── No pre-supplied cell metadata: internal clustering ─────────────────
    cell_metadata       = null
    cluster_assignments = null
    cell_type_labels    = null
    priming_blacklist   = null

    // ── Outputs ────────────────────────────────────────────────────────────
    outdir = 'results/dengue/day1_wk2'

    // ── Pipeline mode ──────────────────────────────────────────────────────
    run_mode                   = 'full'
    aligner                    = 'starsolo'
    protocol_mode              = '10x_3p'
    enable_internal_clustering = true
    grouping_levels            = 'cluster,cell_type,sample_condition_celltype'
    skip_uninformative_cell_type_grouping = true

    // ── Coverage ───────────────────────────────────────────────────────────
    emit_group_bams = false
    emit_bigwigs    = true

    // ── APA parameters ─────────────────────────────────────────────────────
    apa_min_coverage                  = 5
    apa_min_pdui_delta                = 0.2
    apa_grouping_levels               = 'cluster,cell_type'
    apa_group_level                   = 'cluster'
    apa_model_type                    = 'random_forest'
    enable_single_cell_apa_projection = false

    // ── MVP toggles ────────────────────────────────────────────────────────
    enable_pas_reference_build   = true
    enable_sierra_quant          = true
    enable_pas_scoring           = false
    enable_scapture              = true
    enable_ml_model              = false

    // ── Resource limits (deepthought: Ryzen 7800X3D, 8c/16t, 124 GiB) ────────
    max_cpus   = 16
    max_memory = '120 GB'
    max_time   = '48 h'
}

process {
    executor = 'local'

    withName: 'PREPARE_REFERENCE_BUNDLE' {
        cpus   = 16
        memory = '96 GB'
        time   = '16 h'
    }

    withName: 'STARSOLO_ALIGN_SC' {
        cpus   = 16
        memory = '96 GB'
        time   = '24 h'
    }

    withLabel: process_high {
        cpus   = 16
        memory = '96 GB'
        time   = '24 h'
    }

    withLabel: process_medium {
        cpus   = 8
        memory = '48 GB'
        time   = '12 h'
    }

    // ~10 k cells × 2 samples (merged lanes) → larger AnnData than day1 alone.
    withName: 'SCANPY_CLUSTER_SC' {
        cpus   = 8
        memory = '64 GB'
        time   = '8 h'
    }

    withLabel: process_python {
        cpus   = 8
        memory = '32 GB'
        time   = '8 h'
    }

    withLabel: process_single {
        cpus   = 4
        memory = '16 GB'
        time   = '8 h'
    }

    withName: 'COVERAGE_TRACKS' {
        cpus   = 4
        memory = '16 GB'
        time   = '12 h'
    }

    withName: 'SIERRA_QUANT' {
        cpus   = 4
        memory = '32 GB'
        time   = '12 h'
    }

    withName: 'APA_FEATURE_EXTRACTION' {
        cpus   = 4
        memory = '24 GB'
        time   = '8 h'
    }
}
