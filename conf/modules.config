process {
        withName: STARSOLO_ALIGN_SC {
        ext.args = '--soloType CB_UMI_Simple --outSAMtype BAM SortedByCoordinate --outSAMattributes NH HI nM AS CR UR CY UY CB UB GX GN'
    }
    // SCAPTURE runs PAScall over all transcripts genome-wide — inherently slow.
    // Give it dedicated resources so it never kills the rest of the pipeline.
    withName: 'SCAPTURE_FILTER' {
        cpus   = 14
        memory = '64 GB'
        time   = '48 h'
    }
    withName: 'SCAPTURE_PASCALL' {
        cpus   = 14
        memory = '64 GB'
        time   = '48 h'
        // Overrides the host's broad withLabel:gpu containerOptions='--nv'.
        // --nv comes from apptainer.runOptions; this task also needs its
        // staged patched predictor bound inside the image.
        containerOptions = { params.apptainer_cache_dir ? "--bind ${predict_script}:/opt/scapture/DeepPASS/Predict.py" : '' }
        publishDir = [path: "${params.outdir}/scapture", mode: params.publish_dir_mode,
                      saveAs: { name -> name == 'versions.yml' ? null : name }]
    }
    withName: 'SCAPTURE_PASQUANT' {
        cpus   = 14
        memory = '64 GB'
        time   = '48 h'
        publishDir = [path: "${params.outdir}/scapture", mode: params.publish_dir_mode,
                      saveAs: { name -> name == 'versions.yml' ? null : name }]
    }
    // Staged modules keep nf-core-style process code free of publishDir.
    // Only scientific outputs and logs are copied; versions.yml stays in work.
    withName: 'SCAPTURE_PASMERGE' {
        publishDir = [path: "${params.outdir}/scapture", mode: params.publish_dir_mode,
                      saveAs: { name -> name == 'versions.yml' ? null : name }]
    }
    withName: 'SCAPTURE_PASREFERENCE' {
        publishDir = [path: "${params.outdir}/scapture", mode: params.publish_dir_mode,
                      saveAs: { name -> name == 'versions.yml' ? null : name }]
    }
    withName: 'SCAPTURE_CATALOG' {
        publishDir = [path: "${params.outdir}/scapture", mode: params.publish_dir_mode,
                      saveAs: { name -> name == 'versions.yml' ? null : name }]
    }
    withName: 'SCAPTURE_MANIFEST' {
        publishDir = [path: "${params.outdir}/scapture", mode: params.publish_dir_mode,
                      saveAs: { name -> name == 'versions.yml' ? null : name }]
    }

    withName: GPU_SPLICED_ALIGN_SC {
        ext.args = '--placeholder'
    }

    withName: GROUPED_3PRIME_COVERAGE {
        ext.args = '--min-mapq 255 --count-mode 3prime'
    }

    withName: APA_QUANTIFY_SITE_USAGE {
        ext.args = '--dedup-key CB,UB,gene,site_bin,strand'
    }

    withName: APA_TEST_DIFFERENTIAL_USAGE {
        ext.args = '--fdr 0.05 --min-replicates 2'
    }
}
