process {
        withName: STARSOLO_ALIGN_SC {
        ext.args = '--soloType CB_UMI_Simple --outSAMtype BAM SortedByCoordinate --outSAMattributes NH HI nM AS CR UR CY UY CB UB GX GN'
    }
    // SCAPTURE runs PAScall over all transcripts genome-wide — inherently slow.
    // Give it dedicated resources so it never kills the rest of the pipeline.
    withName: 'SCAPTURE_FILTER' {
        cpus   = 14
        memory = '64 GB'
        time   = '48 h'
    }
    withName: '.*SIERRA_QUANT_PREPARE' {
        container = { params.apptainer_cache_dir ? "${params.apptainer_cache_dir}/scpolaseq-r.sif" : 'ghcr.io/martings/sierra:84b71c4' }
    }
    withName: '.*SIERRA_COUNTPEAKS' {
        container = { params.apptainer_cache_dir ? "${params.apptainer_cache_dir}/scpolaseq-r.sif" : 'ghcr.io/martings/sierra:84b71c4' }
        ext.args  = {
            def s = (meta.strandedness ?: (meta.chemistry == '10xv1' ? 'reverse' : (params.strandedness ?: 'forward'))).toString().toLowerCase()
            "--strand-mode ${s == 'reverse' ? 2 : (s == 'unstranded' ? 0 : 1)}"
        }
    }
    withName: '.*SIERRA_QUANT_TABLE' {
        container  = { params.apptainer_cache_dir ? "${params.apptainer_cache_dir}/scpolaseq-r.sif" : 'ghcr.io/martings/sierra:84b71c4' }
        publishDir = [path: { "${params.outdir}/sierra_quant/${group_level}" }, mode: params.publish_dir_mode,
                      saveAs: { name -> name == 'versions.yml' ? null : name }]
    }

    // Staged SCAPTURE modules remain free of params.* and publishDir; runtime
    // flags, OCI/Apptainer container selection, and publishing live here.
    withName: '.*SCAPTURE_(PREPARE|ANNOTATION|PASCALL|PASMERGE|PASREFERENCE|CATALOG|PASQUANT|MANIFEST)' {
        container = { params.apptainer_cache_dir ? "${params.apptainer_cache_dir}/scpolaseq-scapture.sif" : 'ghcr.io/martings/scapture:f056f02' }
    }
    withName: '.*SCAPTURE_PASCALL' {
        cpus   = 14
        memory = '64 GB'
        time   = '48 h'
        ext.normality_seed = { params.scapture_normality_seed == null ? 1 : params.scapture_normality_seed }
        ext.args = {
            def species    = params.scapture_species ?: 'human'
            def read_len   = params.scapture_read_length ?: 90
            def peak_width = params.scapture_peak_width ?: 400
            def strand     = (meta.strandedness ?: (meta.chemistry == '10xv1' ? 'reverse' : (params.scapture_strand ?: params.strandedness ?: 'forward'))).toString().toLowerCase()
            "-l ${read_len} --species ${species} -w ${peak_width} --strand ${strand}"
        }
        // --nv comes from apptainer.runOptions in deepthought.config.
        publishDir = [path: "${params.outdir}/scapture", mode: params.publish_dir_mode,
                      saveAs: { name -> name == 'versions.yml' ? null : name }]
    }
    withName: '.*SCAPTURE_PASQUANT' {
        cpus   = 14
        memory = '64 GB'
        time   = '48 h'
        ext.args = {
            def strand = (meta.strandedness ?: (meta.chemistry == '10xv1' ? 'reverse' : (params.scapture_strand ?: params.strandedness ?: 'forward'))).toString().toLowerCase()
            "--strand ${strand}"
        }
        publishDir = [path: "${params.outdir}/scapture", mode: params.publish_dir_mode,
                      saveAs: { name -> name == 'versions.yml' ? null : name }]
    }
    withName: '.*SCAPTURE_ANNOTATION' {
        // Keep the annotation log without copying the large annotation bundle.
        publishDir = [path: "${params.outdir}/scapture", mode: params.publish_dir_mode,
                      saveAs: { name -> name.endsWith('.annotation.log') ? name : null }]
    }
    withName: '.*SCAPTURE_PASMERGE' {
        publishDir = [path: "${params.outdir}/scapture", mode: params.publish_dir_mode,
                      saveAs: { name -> name == 'versions.yml' ? null : name }]
    }
    withName: '.*SCAPTURE_PASREFERENCE' {
        publishDir = [path: "${params.outdir}/scapture", mode: params.publish_dir_mode,
                      saveAs: { name -> name == 'versions.yml' ? null : name }]
    }
    withName: '.*SCAPTURE_CATALOG' {
        ext.args   = {
            def thr = params.scapture_deeppass_threshold != null ? params.scapture_deeppass_threshold : 0.5
            "--threshold ${thr}"
        }
        publishDir = [path: "${params.outdir}/scapture", mode: params.publish_dir_mode,
                      saveAs: { name -> name == 'versions.yml' ? null : name }]
    }
    withName: '.*SCAPTURE_MANIFEST' {
        ext.args   = {
            def species        = params.scapture_species ?: 'human'
            def read_len       = params.scapture_read_length ?: 90
            def peak_width     = params.scapture_peak_width ?: 400
            def normality_seed = params.scapture_normality_seed == null ? 1 : params.scapture_normality_seed
            def thr            = params.scapture_deeppass_threshold != null ? params.scapture_deeppass_threshold : 0.5
            "--species ${species} --read-length ${read_len} --peak-width ${peak_width} --normality-seed ${normality_seed} --threshold ${thr}"
        }
        publishDir = [path: "${params.outdir}/scapture", mode: params.publish_dir_mode,
                      saveAs: { name -> name == 'versions.yml' ? null : name }]
    }
}
